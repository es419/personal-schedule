# Google OAuth client (Google Auth Platform -> Clients -> Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Recommended for a personal app: only this Google account may enter.
ALLOWED_EMAIL=

# Telegram reminders
TELEGRAM_BOT_TOKEN=
CRON_SECRET=

# Service account used ONLY by the background reminder checker.
# The app automatically shares its own schedule spreadsheet with this account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
